  "accepted_event_types": [
    "ROLE_LEASE_ASSIGNED",
    "ROLE_LEASE_RELEASED",
    "ROLE_LEASE_TRANSFERRED",
    "ROLE_LEASE_RENEWED",
    "ROLE_LEASE_REAPED",
    "MATERIAL_AUTHOR",
    "GATE",
    "CAPACITY_DEGRADED",
    "CAPACITY_RECOVERED",
    "SUPERVISION_CHECK",
    "HUMAN_DECISION",
    "INTEGRITY_CONFLICT_RESOLVED",
    "MERGED"
  ]
